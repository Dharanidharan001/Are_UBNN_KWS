#=============================================================================
# Yosys Synthesis Script: ARe-UBNN-KWS Enhanced Architecture
# Target: SKY130 High Density (sky130_fd_sc_hd)
#=============================================================================

# Read SKY130 Standard Cell Library
read_liberty -lib constraints/sky130_fd_sc_hd__tt_025C_1v80.lib

# Read Synthesizable RTL Modules with SYNTHESIS defined
read_verilog -sv -DSYNTHESIS src/popcount16.sv
read_verilog -sv -DSYNTHESIS src/unipolar_pe.sv
read_verilog -sv -DSYNTHESIS src/secded_encoder.sv
read_verilog -sv -DSYNTHESIS src/secded_decoder.sv
read_verilog -sv -DSYNTHESIS src/protected_weight_memory.sv
read_verilog -sv -DSYNTHESIS src/pe_activity_detector.sv
read_verilog -sv -DSYNTHESIS src/icg_cell.sv
read_verilog -sv -DSYNTHESIS src/pe_array16.sv
read_verilog -sv -DSYNTHESIS src/accumulator.sv
read_verilog -sv -DSYNTHESIS src/threshold_unit.sv
read_verilog -sv -DSYNTHESIS src/controller.sv
read_verilog -sv -DSYNTHESIS src/are_ubnn_kws_top.sv

# Elaborate Top Module
hierarchy -check -top are_ubnn_kws_top

# High-Level Synthesis Optimization
synth -top are_ubnn_kws_top

# Sequential Mapping to SKY130 D-Flip-Flops
dfflibmap -liberty constraints/sky130_fd_sc_hd__tt_025C_1v80.lib

# Combinational Mapping to SKY130 Standard Cells
abc -liberty constraints/sky130_fd_sc_hd__tt_025C_1v80.lib

# Netlist Clean-Up
clean

# Generate Area & Cell Count Statistics
stat -liberty constraints/sky130_fd_sc_hd__tt_025C_1v80.lib

# Write Gate-Level Netlist
write_verilog -noattr outputs/netlist/are_ubnn_kws_enhanced.netlist.v
